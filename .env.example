# ASTRA configuration. Copy to .env (repo root) and adjust.
# Every value is optional for a local run: with no .env at all ASTRA starts with
# SQLite, a generated secret key, the seeded demo catalogue and fully offline AI.

# --- Database ------------------------------------------------------------------
# Empty = local SQLite file at backend/data/astra.db (zero setup).
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
ASTRA_DATABASE_URL=

# Used only by docker-compose.yml for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# --- Security ------------------------------------------------------------------
# Signs login tokens. Empty = a random key is generated once in backend/data/secret.key.
# Required for Docker. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ASTRA_SECRET_KEY=
ASTRA_ACCESS_TOKEN_MINUTES=480
# Extra browser origins allowed to call the API (only needed for the Vite dev server).
ASTRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo data -----------------------------------------------------------------
# true = seed demo users, sensors, medical rules and scenarios into an EMPTY database.
ASTRA_SEED_DEMO_DATA=true
# Set to give all five demo accounts this password instead of the documented ones
# (also hides the one-click demo sign-in buttons on the login page).
ASTRA_DEMO_PASSWORD=

# --- Networking ----------------------------------------------------------------
# Address phones should open when they scan a viewer QR code, e.g. http://192.168.1.20:8000
# Empty = the operator's own browser address, with localhost replaced by the detected LAN IP.
# Set this when running in Docker.
ASTRA_PUBLIC_BASE_URL=

# --- ASTRA AI (LLM) --------------------------------------------------------------
# local             deterministic offline planner + explainer (default, zero network/offline)
# openrouter        Recommended for FREE online LLMs (Llama 3.3 70B, Gemini Flash, etc.)
#                   Get free key at: https://openrouter.ai/keys
# groq              Ultra-fast free inference (Llama 3.3 70B versatile)
#                   Get free key at: https://console.groq.com/keys
# gemini            Google Gemini free tier (gemini-1.5-flash / gemini-2.0-flash-exp)
#                   Get free key at: https://aistudio.google.com/apikey
# anthropic         Claude via Anthropic SDK (reads ANTHROPIC_API_KEY)
# openai_compatible any server with OpenAI chat API (Ollama, LM Studio, vLLM, etc.)
# If the provider is missing, rate-limited, or offline, ASTRA automatically falls back to "local".
ASTRA_LLM_PROVIDER=openrouter
# Empty = provider default.
# For openrouter: meta-llama/llama-3.3-70b-instruct:free (default)
# For groq: llama-3.3-70b-versatile (default)
# For gemini: gemini-1.5-flash (default)
ASTRA_LLM_MODEL=openrouter/free
# Base URL (only needed for custom openai_compatible, e.g. http://localhost:11434/v1)
ASTRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# API key for OpenRouter, Groq, Gemini, or custom OpenAI endpoint:
ASTRA_LLM_API_KEY=
ASTRA_LLM_TIMEOUT_S=60
# Dedicated provider env vars (optional alternatives to ASTRA_LLM_API_KEY):
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GEMINI_API_KEY=AIza_your_gemini_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# --- Speech ----------------------------------------------------------------------
# browser           Web Speech API in the browser (default; speech synthesis works offline)
# openai_compatible server-side STT/TTS on any OpenAI-audio-compatible endpoint
ASTRA_SPEECH_PROVIDER=browser
ASTRA_SPEECH_BASE_URL=
ASTRA_SPEECH_API_KEY=
ASTRA_STT_MODEL=whisper-1
ASTRA_TTS_MODEL=tts-1
ASTRA_TTS_VOICE=alloy
